#!/usr/bin/env bash

set -euo pipefail

fork_tag="fork-v0.9.1-1"
fork_url="https://github.com/brs98/herdr/releases/download/$fork_tag/herdr"
fork_sha256="d8a11dd074018b30691e342cbf09b6cbb5a4b9fa7c2e57a801220d7fe6e49474"
install_dir="${HERDR_FORK_INSTALL_DIR:-$HOME/.local/lib/herdr-fork}"
install_path="$install_dir/herdr"
fork_version="0.9.1-custom.brs98-0.9.1-navigation"
fork_protocol=22
handoff=false

usage() {
    echo "usage: herdr-fork-install [--handoff]"
}

case "${1:-}" in
    "") ;;
    --handoff) handoff=true ;;
    --help|-h)
        usage
        exit 0
        ;;
    *)
        usage >&2
        exit 2
        ;;
esac

if [ "$#" -gt 1 ]; then
    usage >&2
    exit 2
fi

if [ "$(uname -s)" != "Linux" ] || [ "$(uname -m)" != "x86_64" ]; then
    echo "The pinned Herdr fork build supports Linux x86_64 only." >&2
    exit 1
fi

if [ -x "$install_path" ]; then
    installed_sha256="$(sha256sum "$install_path" | awk '{print $1}')"
else
    installed_sha256=""
fi

if [ "$installed_sha256" = "$fork_sha256" ]; then
    echo "    ✓ Herdr fork $fork_tag is already installed"
else
    if ! command -v curl >/dev/null 2>&1; then
        echo "curl is required to install the Herdr fork." >&2
        exit 1
    fi

    download_dir="$(mktemp -d "${TMPDIR:-/tmp}/herdr-fork.XXXXXX")"
    trap 'rm -rf "$download_dir"' EXIT
    download_path="$download_dir/herdr"

    echo "  → Installing Herdr fork $fork_tag..."
    curl --fail --location --retry 3 --silent --show-error \
        --output "$download_path" "$fork_url"

    actual_sha256="$(sha256sum "$download_path" | awk '{print $1}')"
    if [ "$actual_sha256" != "$fork_sha256" ]; then
        echo "Herdr fork checksum mismatch." >&2
        echo "Expected: $fork_sha256" >&2
        echo "Actual:   $actual_sha256" >&2
        exit 1
    fi

    mkdir -p "$install_dir"
    if [ -x "$install_path" ]; then
        mkdir -p "$install_dir/backups"
        install -m 0755 "$install_path" "$install_dir/backups/herdr-$installed_sha256"
        echo "    ✓ Preserved previous client: $install_dir/backups/herdr-$installed_sha256"
    fi
    install -m 0755 "$download_path" "$install_dir/.herdr.new"
    mv -f "$install_dir/.herdr.new" "$install_path"
    echo "    ✓ Installed $install_path"
fi

if [ "$handoff" = true ]; then
    if ! command -v jq >/dev/null 2>&1; then
        echo "jq is required to verify live handoff; binary installed, server unchanged." >&2
        exit 1
    fi

    server_status="$("$install_path" status server --json)"
    if printf '%s\n' "$server_status" | jq -e '.running == false' >/dev/null; then
        echo "    ✓ No running server to migrate"
    elif printf '%s\n' "$server_status" | jq -e --arg version "$fork_version" \
        '.running == true and .version == $version' >/dev/null; then
        echo "    ✓ Running server already uses this fork version"
    else
        client_status="$("$install_path" status client --json)"
        # This 0.9.0 -> 0.9.1 pair was verified with disposable sessions on Linux
        # and macOS, including preserved shell PIDs, scrollback and terminal I/O.
        if ! printf '%s\n' "$client_status" | jq -e --arg version "$fork_version" \
            --argjson protocol "$fork_protocol" \
            '.version == $version and .protocol == $protocol' >/dev/null ||
            ! printf '%s\n' "$server_status" | jq -e \
            '.running == true and .protocol == 22 and .capabilities.live_handoff == true
             and ((.version // "") | test("^0\\.9\\.0(-custom[.].+)?$"))' >/dev/null; then
            echo "Live handoff is not verified for this server/client pair; binary installed, server unchanged." >&2
            echo "Keep its session running until the work is finished, then start a new session." >&2
            exit 1
        fi

        echo "  → Handing the live session to the fork..."
        "$install_path" server live-handoff \
            --import-exe "$install_path" \
            --expected-protocol "$fork_protocol" \
            --expected-version "$fork_version"
        echo "    ✓ Live Herdr session now runs the fork"
    fi
else
    echo "    ✓ Binary ready; running servers and panes were left untouched"
fi
