[Unit]
Description=Watch GameCube Card A saves for changes
After=local-fs.target

[Path]
PathModified=%h/.dotfiles/shared/symlink/retroarch/.config/retroarch/saves/dolphin-emu/User/GC/USA/Card A
PathModified=%h/.config/retroarch/saves/dolphin-emu/User/GC/USA/Card A
Unit=retroarch-saves.service

[Install]
WantedBy=default.target
