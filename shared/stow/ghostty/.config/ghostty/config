# Optional theme — ricekit on macOS, omarchy on Linux (last loaded wins).
# Omarchy 4 moved `current/` from ~/.config to ~/.local/state; both are listed
# so the config works on either layout (missing files are skipped via `?`).
config-file = ?~/.config/ghostty/ricekit-theme
config-file = ?~/.config/omarchy/current/theme/ghostty.conf
config-file = ?~/.local/state/omarchy/current/theme/ghostty.conf

# Window
window-decoration = "none"
background-opacity = 0.5

# Font
font-family = "CaskaydiaMono Nerd Font"
font-style = Regular
font-size = 9

# Window
window-padding-x = 14
window-padding-y = 14
confirm-close-surface = false
resize-overlay = never

# Cursor styling
cursor-style = "block"
cursor-style-blink = false
shell-integration-features = no-cursor

# Keyboard bindings
keybind = f11=toggle_fullscreen
keybind = shift+insert=paste_from_clipboard
keybind = control+insert=copy_to_clipboard

# Slowdown mouse scrolling
mouse-scroll-multiplier = 0.95

# Send Shift+Enter as CSI-u so TUIs can distinguish it from Enter.
keybind = shift+enter=csi:13;2u
# Legacy encoding sends Alt+Shift+Enter the same as Alt+Enter; send CSI-u so tmux can match M-S-Enter.
keybind = alt+shift+enter=csi:13;4u

# Platform overrides
config-file = ?~/.config/ghostty/platform.conf
