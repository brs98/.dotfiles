#!/usr/bin/env bash

set -euo pipefail

usage() {
    cat <<'EOF'
usage: herdr-remote <omarchy|omarchy-pc|mac> [--session <name>]
       herdr-remote doctor

Attach to a machine's default Herdr session over SSH and Tailscale.
Pass --session <name> after the target to attach to a named session.
EOF
}

ssh_alias() {
    case "$1" in
        omarchy|herdr-omarchy) printf '%s\n' herdr-omarchy ;;
        omarchy-pc|herdr-omarchy-pc) printf '%s\n' herdr-omarchy-pc ;;
        mac|macbook|brandons-macbook-pro|herdr-mac) printf '%s\n' herdr-mac ;;
        *) return 1 ;;
    esac
}

fork_client() {
    local candidate client_status

    for candidate in \
        "$HOME/.local/lib/herdr-fork/herdr" \
        "$HOME/.local/bin/herdr" \
        "$(command -v herdr 2>/dev/null || true)"
    do
        if [ -z "$candidate" ] || [ ! -x "$candidate" ]; then
            continue
        fi
        client_status="$("$candidate" status client 2>/dev/null || true)"
        if [ "$(printf '%s\n' "$client_status" | awk '$1 == "version:" {print $2}')" = 0.8.0 ] &&
            [ "$(printf '%s\n' "$client_status" | awk '$1 == "protocol:" {print $2}')" = 20 ]; then
            printf '%s\n' "$candidate"
            return
        fi
    done

    echo "The Herdr 0.8.0 protocol-20 fork is required for Linux thin-client attach." >&2
    return 1
}

attach_over_ssh() {
    local target_alias="$1" remote_command
    shift

    case "$target_alias" in
        herdr-mac) remote_command='exec /opt/homebrew/bin/herdr' ;;
        *) remote_command='exec "$HOME/.local/bin/herdr"' ;;
    esac

    if [ "$#" -eq 0 ]; then
        exec ssh -t "$target_alias" "$remote_command"
    fi
    if [ "$#" -eq 2 ] && [ "$1" = --session ] && [[ "$2" =~ ^[A-Za-z0-9._-]+$ ]]; then
        exec ssh -t "$target_alias" "$remote_command --session $2"
    fi

    echo "SSH-hosted attach supports the default session or --session <name>." >&2
    return 2
}

doctor() {
    local current_host alias result status=0
    current_host="$(hostname -s | tr '[:upper:]' '[:lower:]')"

    if command -v tailscale >/dev/null 2>&1; then
        if ! tailscale status >/dev/null 2>&1; then
            echo "WARN the Tailscale CLI does not report a connected node"
        fi
    else
        echo "WARN Tailscale CLI unavailable; checking SSH/MagicDNS directly"
    fi

    for target in omarchy omarchy-pc mac; do
        alias="$(ssh_alias "$target")"
        if { [ "$target" = "$current_host" ] || { [ "$target" = mac ] && [[ "$current_host" == brandons-macbook-pro* ]]; }; }; then
            printf 'SKIP %-10s this machine\n' "$target"
            continue
        fi

        if result="$(ssh -T -o BatchMode=yes "$alias" '
            for candidate in "$(command -v herdr 2>/dev/null)" "$HOME/.local/bin/herdr" /opt/homebrew/bin/herdr /usr/local/bin/herdr "$HOME/.local/share/mise/shims/herdr"; do
                if [ -n "$candidate" ] && [ -x "$candidate" ]; then
                    exec "$candidate" --version
                fi
            done
            exit 127
        ' 2>&1)"; then
            printf 'OK   %-10s %s\n' "$target" "$result"
        else
            printf 'FAIL %-10s %s\n' "$target" "$(printf '%s\n' "$result" | tail -n 1)"
            status=1
        fi
    done

    return "$status"
}

if [ "$#" -eq 0 ]; then
    usage
    exit 2
fi

if [ "$1" = doctor ]; then
    shift
    if [ "$#" -ne 0 ]; then
        usage >&2
        exit 2
    fi
    doctor
    exit
fi

target="$1"
shift
if ! target_alias="$(ssh_alias "$target")"; then
    echo "unknown Herdr host: $target" >&2
    usage >&2
    exit 2
fi

if [ "$target_alias" = herdr-mac ] || [ "$(uname -s)" = Darwin ]; then
    attach_over_ssh "$target_alias" "$@"
fi

client="$(fork_client)"
exec env -u HERDR_ENV "$client" --remote "$target_alias" "$@"
