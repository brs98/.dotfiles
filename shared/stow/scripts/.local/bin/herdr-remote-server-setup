#!/usr/bin/env bash

set -euo pipefail

usage() {
    cat <<'EOF'
usage: herdr-remote-server-setup [--dry-run]

On an Omarchy host, configure OpenSSH for public-key-only Herdr access from
the other two named Tailscale computers. Applying the config requires sudo.
EOF
}

dry_run=false
case "${1:-}" in
    '') ;;
    --dry-run) dry_run=true ;;
    -h|--help) usage; exit 0 ;;
    *) usage >&2; exit 2 ;;
esac
[ "$#" -le 1 ] || { usage >&2; exit 2; }

if [ "$(uname -s)" != Linux ]; then
    echo "This command configures OpenSSH on the two Omarchy/Linux hosts only." >&2
    echo "On macOS, enable System Settings > General > Sharing > Remote Login." >&2
    exit 1
fi

for command in jq sshd tailscale; do
    command -v "$command" >/dev/null 2>&1 || {
        echo "required command not found: $command" >&2
        exit 1
    }
done

current_host="$(hostname -s | tr '[:upper:]' '[:lower:]')"
case "$current_host" in
    omarchy|omarchy-pc) ;;
    *) echo "expected hostname omarchy or omarchy-pc, got $current_host" >&2; exit 1 ;;
esac

status_json="$(tailscale status --json)"
peer_selectors=()
for peer in omarchy omarchy-pc brandons-macbook-pro; do
    if [ "$peer" = "$current_host" ]; then
        continue
    fi
    peer_ip="$(jq -r --arg host "$peer" '.Peer[] | select(.HostName == $host or (.DNSName | split(".")[0]) == $host) | .TailscaleIPs[] | select(test("^100\\."))' <<< "$status_json" | head -n 1)"
    if [ -z "$peer_ip" ]; then
        echo "could not find the Tailscale IPv4 address for $peer" >&2
        exit 1
    fi
    peer_selectors+=("$(id -un)@$peer_ip")
done

temp_config="$(mktemp "${TMPDIR:-/tmp}/herdr-sshd.XXXXXX")"
trap 'rm -f "$temp_config"' EXIT
{
    echo '# Generated by herdr-remote-server-setup.'
    echo '# Tailscale-only, public-key SSH for Herdr remote attach.'
    echo 'AddressFamily inet'
    echo 'HostKey /etc/ssh/ssh_host_ed25519_key'
    printf 'AllowUsers'
    printf ' %s' "${peer_selectors[@]}"
    printf '\n'
    echo 'AuthenticationMethods publickey'
    echo 'PubkeyAuthentication yes'
    echo 'PasswordAuthentication no'
    echo 'KbdInteractiveAuthentication no'
    echo 'PermitEmptyPasswords no'
    echo 'PermitRootLogin no'
    echo 'UsePAM yes'
    echo 'PermitTTY yes'
    echo 'DisableForwarding yes'
    echo 'PermitUserEnvironment no'
    echo 'MaxAuthTries 3'
} > "$temp_config"

if "$dry_run"; then
    sed -E 's/^(AllowUsers).*/\1 [two Tailscale peer selectors]/' "$temp_config"
    exit 0
fi

target=/etc/ssh/sshd_config.d/20-herdr-tailscale.conf
backup="${target}.pre-herdr-remote.$(date +%Y%m%d%H%M%S)"
if sudo test -f "$target"; then
    sudo cp -p "$target" "$backup"
fi
sudo install -m 0644 -o root -g root "$temp_config" "$target"
if ! sudo sshd -t; then
    echo "sshd rejected the new config; restoring the previous file." >&2
    if sudo test -f "$backup"; then
        sudo mv "$backup" "$target"
    else
        sudo rm -f "$target"
    fi
    exit 1
fi
sudo systemctl reload sshd
echo "OpenSSH now accepts public-key Herdr connections from the other two Tailscale computers."
