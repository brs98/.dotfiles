{
  "name": "fusion",
  "description": "Fusion orchestration without ambient global extensions.",
  "resources": {
    "extensions": "explicit",
    "skills": "discover",
    "prompts": "discover",
    "themes": "discover"
  },
  "packages": [],
  "extensions": [
    {
      "path": "../../extensions/fusion-harness/index.ts",
      "provides": {
        "commands": ["fh-reset", "thinking", "system-prompt", "fusion", "auto-validate", "opinion"],
        "flags": [
          "architect",
          "builder",
          "max-validations",
          "escalate-to-validator-count",
          "architect-system-prompt",
          "builder-system-prompt",
          "architect-thinking",
          "builder-thinking",
          "child-timeout",
          "allow-model-authored-gates"
        ],
        "uiSlots": ["footer"]
      }
    }
  ],
  "piArguments": [
    "--model",
    "openai-codex/gpt-5.6-sol",
    "--architect",
    "claude-code/claude-fable-5",
    "--builder",
    "openai-codex/gpt-5.6-sol"
  ]
}
